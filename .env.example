# --- Sign-in ---------------------------------------------------------------
# The first admin account, created on startup when there are no users yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
# Sessions are signed with SECRET_KEY. In development a random key is generated on
# each start (you'll be signed out on restart); set one to stay signed in.
# SECRET_KEY=

# --- LLM -------------------------------------------------------------------
# Without a key, TalentFlow runs in offline mode with heuristic agents.
ANTHROPIC_API_KEY=
# auto | anthropic | mock
LLM_PROVIDER=auto
DEFAULT_MODEL=claude-opus-5
# Optional per-agent overrides, e.g. a cheaper model for high-volume steps:
# MODEL_SOURCING=claude-haiku-4-5
# MODEL_SCREENING=claude-sonnet-5
# MODEL_OUTREACH=claude-sonnet-5
# MODEL_SCHEDULING=claude-haiku-4-5
# MODEL_EVALUATION=claude-opus-5
# low | medium | high | xhigh | max
LLM_EFFORT=high

# --- Database --------------------------------------------------------------
# Docker Compose sets this to its bundled Postgres + pgvector automatically.
# For local dev without Postgres, the SQLite default just works.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/talentflow
# DATABASE_URL=sqlite:///./talentflow.db

# --- Embeddings ------------------------------------------------------------
# fastembed (local, no key) | voyage (hosted) | hash (tests only)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# For Voyage AI:
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-3.5
# EMBEDDING_DIM=1024
# VOYAGE_API_KEY=

# --- Company ---------------------------------------------------------------
COMPANY_NAME=Acme Corp
# IANA timezone for interview slots, e.g. America/New_York, Europe/London, Asia/Kolkata
TIMEZONE=UTC
INTERVIEW_DURATION_MINUTES=45
