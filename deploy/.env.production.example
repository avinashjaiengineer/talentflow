# Copy to deploy/.env.production (never commit it). deploy.sh fills the random secrets for you.

# --- Required --------------------------------------------------------------
SECRET_KEY=            # 48+ random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=     # random, URL-safe:  python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=        # first admin; change it after signing in
ANTHROPIC_API_KEY=     # without it the agents run in offline heuristic mode

# --- HTTPS -------------------------------------------------------------------
# Point an A record at the server, then set DOMAIN and COOKIE_SECURE=true.
DOMAIN=
COOKIE_SECURE=false

# --- Optional ----------------------------------------------------------------
COMPANY_NAME=Acme Corp
TIMEZONE=UTC
DEFAULT_MODEL=claude-opus-5
LLM_EFFORT=high
# On AWS, deploy.sh also layers docker-compose.aws.yml to ship logs to CloudWatch.

# --- Email, calendar, Teams, AI calls (see docs/INTEGRATIONS.md) -----------
# All off by default: nothing reaches a candidate until a provider is connected.
EMAIL_PROVIDER=outbox        # outbox | graph (Outlook)
CALENDAR_PROVIDER=local      # local | graph (Outlook free/busy + Teams meetings)
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER=recruiting@yourcompany.com
VOICE_PROVIDER=simulated     # simulated | twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+14155550100
# PUBLIC_BASE_URL=https://talent.yourcompany.com   # required for Twilio (https)
# MODEL_CALLER=claude-haiku-4-5                    # fastest replies on live calls
# REMINDER_HOURS_BEFORE=24
